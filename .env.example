# ---------------------------------------------------------------------------
# LeadDesk Mini — environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# DATABASE_URL: the POOLED connection string (Transaction mode, port 6543).
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# "Transaction pooler". Serverless functions on Vercel open a new connection
# per invocation, so the pooler is required to avoid exhausting Postgres.
# Keep `?pgbouncer=true&connection_limit=1` — pgbouncer cannot handle prepared
# statements, and this tells Prisma to stop emitting them.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: the DIRECT connection string (Session mode, port 5432).
# Used only by `prisma migrate` / `prisma db seed`, which need a session-mode
# connection that the transaction pooler cannot provide.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth.js / NextAuth v5 --------------------------------------------------
# Secret used to sign & encrypt the JWT session cookie. Generate with:
#   openssl rand -base64 32
# Must be set in production or NextAuth refuses to start.
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin of the deployment. Locally this is http://localhost:3000;
# on Vercel set it to your production URL (https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# --- Seed credentials -------------------------------------------------------
# Used ONLY by `prisma/seed.ts` to create the first admin account. The password
# is bcrypt-hashed before it touches the database — it is never stored as-is.
SEED_ADMIN_EMAIL="admin@leaddesk.test"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
